{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__meshy__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/reuse-guard.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__meshy__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/pending-record.mjs\""
          }
        ]
      }
    ]
  }
}
